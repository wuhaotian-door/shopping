<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.class242014group06.mapper.InheritorProfileMapper">

    <update id="update" parameterType="InheritorProfile">
        update inheritor_profile
        <set>
            <if test="honorTitle != null">honor_title = #{honorTitle},</if>
            <if test="selfIntro != null">self_intro = #{selfIntro},</if>
            <if test="craftTypes != null">craft_types = #{craftTypes},</if>
            <if test="address != null">address = #{address},</if>
            <if test="avatarUrl != null">avatar_url = #{avatarUrl},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where id = #{id}
    </update>

</mapper>
