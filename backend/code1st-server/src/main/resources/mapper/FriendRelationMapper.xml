<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.class242014group06.mapper.FriendRelationMapper">

    <resultMap id="friendRelationResultMap" type="com.class242014group06.entity.FriendRelation">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="friendId" column="friend_id"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 查询用户的好友列表（双向已接受） -->
    <select id="listFriends" resultMap="friendRelationResultMap">
        SELECT * FROM friend_relation
        WHERE status = 1 AND (user_id = #{userId} OR friend_id = #{userId})
        ORDER BY updated_at DESC
    </select>

    <!-- 查询待处理的好友申请（别人发给我的） -->
    <select id="listPendingRequests" resultMap="friendRelationResultMap">
        SELECT * FROM friend_relation
        WHERE friend_id = #{userId} AND status = 0
        ORDER BY created_at DESC
    </select>

</mapper>
