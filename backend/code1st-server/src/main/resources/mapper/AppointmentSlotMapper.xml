<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.class242014group06.mapper.AppointmentSlotMapper">

    <update id="update" parameterType="AppointmentSlot">
        update appointment_slot
        <set>
            <if test="slotDate != null">slot_date = #{slotDate},</if>
            <if test="timeSlot != null">time_slot = #{timeSlot},</if>
            <if test="maxPeople != null">max_people = #{maxPeople},</if>
            <if test="bookedCount != null">booked_count = #{bookedCount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where id = #{id}
    </update>

</mapper>
