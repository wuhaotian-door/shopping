<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.class242014group06.mapper.ChatMapper">

    <resultMap id="conversationResultMap" type="com.class242014group06.entity.ChatConversation">
        <id property="id" column="id"/>
        <result property="conversationType" column="conversation_type"/>
        <result property="title" column="title"/>
        <result property="lastMessage" column="last_message"/>
        <result property="lastMessageTime" column="last_message_time"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="participantResultMap" type="com.class242014group06.entity.ChatParticipant">
        <id property="id" column="id"/>
        <result property="conversationId" column="conversation_id"/>
        <result property="userId" column="user_id"/>
        <result property="userRole" column="user_role"/>
        <result property="userName" column="user_name"/>
        <result property="joinedAt" column="joined_at"/>
    </resultMap>

    <!-- 查询用户的会话列表 -->
    <select id="listUserConversations" resultMap="conversationResultMap">
        SELECT DISTINCT c.* FROM chat_conversation c
        INNER JOIN chat_participant p ON c.id = p.conversation_id
        WHERE p.user_id = #{userId} AND p.user_role = #{userRole}
        ORDER BY c.last_message_time DESC, c.updated_at DESC
    </select>

</mapper>
